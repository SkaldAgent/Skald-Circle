{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skald",
  "version": "0.1.0",
  "identifier": "ai.skald.desktop",
  "build": {
    "frontendDist": "./web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": {
      "agents/": "agents/",
      "web/": "web/",
      "skills/": "skills/",
      "commands/": "commands/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
