{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "permission": {
    "bash": {
      "cargo *": "allow",
      "./run.sh": "allow",
      "./run-docker.sh": "allow",
      "./run-log.sh": "allow",
      "./backup.sh": "allow",
      "rg *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "*": "ask"
    },
    "external_directory": { "*": "allow" }
  },
  "tool_output": { "max_lines": 200, "max_bytes": 16384 }
}
